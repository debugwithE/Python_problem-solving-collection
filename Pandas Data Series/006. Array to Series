# 6. Array to Series
# Write a Pandas program to convert a NumPy array to a Pandas series
Sample Series: 
  NumPy array:
[10 20 30 40 50]
Converted Pandas series:
0    10
1    20
2    30
3    40
4    50
dtype: int64

#6.
import numpy as np
import pandas as pd

a=np.array([10, 20, 30, 40, 50])
print("NumPy Array: ", a)
d=pd.Series(a)
print("Array converted to Pandas Series:")
print(d)
