# 8. Find longest word in a list.
# Write a Python function that takes a list of words and return the longest word and the length of the longest one.
Sample Output:
Longest word: Exercises
Length of the longest word: 9

def longestw(words_list):
    word_len=[]

    for n in words_list:     # Iterate through each word 'n' in words_list
        word_len.append((len(n), n))     # Append a tuple containing the length of the word and the word
                                         # double bracket because append takes 

        word_len.sort()
        
    return word_len[-1][0], word_len[-1][1]

result=longestw(["PHP", "Exercises", "Backend"])
print("\nLongest Word: ", result[1])
print("\nLength of the longest Word: ", result[0]) 
